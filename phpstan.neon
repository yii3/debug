includes:
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:
    level: max

    paths:
        - src
        - tests

    excludePaths:
        # These fixtures redeclare dispatcher event names for process-isolated tests. Analysing them would make
        # PHPStan resolve those names to the fixture instead of the installed package, project-wide.
        - tests/Support/Stubs/after-middleware-event.php
        - tests/Support/Stubs/before-middleware-event.php

    tmpDir: %currentWorkingDirectory%/runtime

    checkImplicitMixed: true
    checkBenevolentUnionTypes: true
    checkUninitializedProperties: true
    checkMissingCallableSignature: true
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    reportAnyTypeWideningInVarTag: true
    reportPossiblyNonexistentConstantArrayOffset: true
    reportPossiblyNonexistentGeneralArrayOffset: true
